{
  "scripts": {
    "db:erd": "tsx tools/database/generate-erd.ts",
    "db:erd:supabase": "bash infrastructure/database/introspection/supabase/scripts/export-erd.sh",
    "db:context:local": "bash infrastructure/database/introspection/local/scripts/export-context.sh",
    "db:schema:local": "bash infrastructure/database/introspection/local/scripts/export-context.sh --schema-only",
    "db:erd:local": "bash infrastructure/database/introspection/local/scripts/export-erd.sh",
    "tiles:export": "bash infrastructure/tiles/pmtiles/scripts/export-region.sh",
    "tiles:build": "bash infrastructure/tiles/pmtiles/scripts/build-region.sh",
    "tiles:rebuild": "bash infrastructure/tiles/pmtiles/scripts/rebuild-region.sh",
    "tiles:build:regions": "bash infrastructure/tiles/pmtiles/scripts/build-all-regions.sh",
    "tiles:rebuild:regions": "bash infrastructure/tiles/pmtiles/scripts/rebuild-all-regions.sh",
    "tiles:rebuild:regions:resilient": "bash infrastructure/tiles/pmtiles/scripts/run-all-regions-resilient.sh",
    "tiles:export:yangon:v1": "npm run tiles:export -- yangon v1",
    "tiles:build:yangon:v1": "npm run tiles:build -- yangon v1",
    "tiles:rebuild:yangon:v1": "npm run tiles:rebuild -- yangon v1",
    "tiles:export:yangon:v2": "npm run tiles:export -- yangon v2",
    "tiles:build:yangon:v2": "npm run tiles:build -- yangon v2",
    "tiles:rebuild:yangon:v2": "npm run tiles:rebuild -- yangon v2",
    "tiles:build:yangon:v2:roads-only": "npm run tiles:build -- yangon v2 --roads-only",
    "tiles:build:yangon:v2:skip-buildings": "npm run tiles:build -- yangon v2 --skip-buildings",
    "tiles:build:yangon:v2:light-only": "npm run tiles:build -- yangon v2 --light-only",
    "tiles:upload": "bash infrastructure/tiles/pmtiles/scripts/upload-package-r2.sh",
    "tiles:upload:r2": "bash infrastructure/tiles/pmtiles/scripts/upload-r2.sh",
    "tiles:upload:yangon:v2": "npm run tiles:upload:r2 -- infrastructure/tiles/pmtiles/regions/yangon/yangon-v2.pmtiles yangon v2",
    "tiles:serve": "bash infrastructure/tiles/pmtiles/scripts/serve-local.sh",
    "tiles:build:overview": "bash infrastructure/tiles/pmtiles/scripts/build-overview.sh",
    "tiles:rebuild:overview": "bash infrastructure/tiles/pmtiles/scripts/rebuild-overview.sh",
    "tiles:verify:overview": "bash infrastructure/tiles/pmtiles/scripts/verify-overview-local.sh",
    "test:overview-style": "npm test --prefix packages/map-style"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "pg": "^8.20.0",
    "pmtiles": "^4.4.1"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "tsx": "^4.21.0"
  }
}
