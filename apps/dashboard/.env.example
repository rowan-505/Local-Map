# Copy to apps/dashboard/.env.local
# Dashboard is an API client only. No database URLs.

NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_TILE_SERVER_URL=http://localhost:3002
NEXT_PUBLIC_BASEMAP_PMTILES_URL=
NEXT_PUBLIC_LOCAL_REGION_PMTILES_BASE_URL=http://localhost:8080/regions
NEXT_PUBLIC_OVERVIEW_PMTILES_URL=
NEXT_PUBLIC_IMPORT_REVIEW_SNAPSHOT_VERSION=

# Local import-review only. This value is public in the browser bundle.
# Leave empty unless you also set the same token on the API.
NEXT_PUBLIC_IMPORT_REVIEW_ADMIN_TOKEN=
