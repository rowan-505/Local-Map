{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@local-map/map-style/*": ["../../packages/map-style/*"],
      "@local-map/core-review-policy": [
        "../../packages/core-review-policy/township-admin-policy.ts"
      ],
      "@local-map/transport-timetable": [
        "../../packages/transport-timetable/timetable.ts"
      ],
      "@local-map/transport-timetable/transport-time": [
        "../../packages/transport-timetable/transport-time.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
