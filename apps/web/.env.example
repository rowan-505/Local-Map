# Copy to apps/web/.env.local — example variable names only (no secrets).

# Required — Fastify API for search, POIs, routing, share links
VITE_API_BASE_URL=http://localhost:3001
# Production: the map app (map.coremapmm.com) calls the API at:
# VITE_API_BASE_URL=https://api.coremapmm.com

# Martin dynamic vector tiles (transport overlay). Optional; overlay disabled when unset.
VITE_MARTIN_TILE_URL=http://localhost:3002

# --- Basemap manifest (preferred production path) ---
# Overview + regional PMTiles registry. Defaults to the bundled /basemaps/manifest.json.


# --- Legacy single-PMTiles basemap (fallback only, used if the manifest fetch fails) ---
# VITE_BASEMAP_PMTILES_URL=https://example.cdn/basemaps/yangon/v1/basemap.pmtiles
# VITE_BASEMAP_CURRENT_JSON_URL=http://localhost:8080/regions/yangon/current.json

# Yangon road labels from export GeoJSON (no PMTiles rebuild). Auto in dev when Yangon URL is set.
# VITE_YANGON_ROAD_LABELS_GEOJSON_URL=http://localhost:8080/exports/yangon/road_labels.geojson
# VITE_YANGON_ROAD_LABELS_OVERLAY=1

# --- Overview basemap (Natural Earth z0–z8) — direct .pmtiles URL only ---
# Composed with regional tiles by default when set. Run: npm run tiles:serve (repo root)
# VITE_OVERVIEW_PMTILES_URL=http://localhost:8080/overview/regions/myanmar-overview-v1.pmtiles
# Production example:
# VITE_OVERVIEW_PMTILES_URL=https://YOUR_TILE_DOMAIN/basemaps/overview/v1/basemap.pmtiles
# Overview-only mode (optional local test):
# VITE_MAP_BASEMAP=overview

# --- Local QA: load all 15 regional PMTiles at once (dev only, may be slow) ---
# Requires npm run tiles:serve and built archives under infrastructure/tiles/pmtiles/regions/
# VITE_LOAD_ALL_LOCAL_REGION_PMTILES=true
# VITE_OVERVIEW_PMTILES_URL=http://localhost:8080/overview/regions/myanmar-overview-v1.pmtiles
