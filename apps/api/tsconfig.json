{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "../..",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "../../packages/transport-timetable/timetable.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
