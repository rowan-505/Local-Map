{
  "name": "local-map-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test:entity-names": "node --import tsx --test src/lib/entity-names/entity-names.test.ts",
    "test:address-composer": "node --import tsx --test src/modules/addresses/address-composer.test.ts",
    "test:plus-code": "node --import tsx --test src/lib/geo/plus-code.test.ts",
    "test:minimal-address-composer": "node --import tsx --test src/modules/addresses/minimal-address-composer.test.ts",
    "check:streets-names": "tsx scripts/check-street-name-normalization.ts",
    "build:routing-graph": "tsx src/scripts/build-routing-graph.ts",
    "docs:api": "tsx scripts/generate-api-docs.ts",
    "curl-examples:import-review-auth": "bash scripts/import-review-admin-curl-examples.sh",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@prisma/client": "^6.15.0",
    "@supabase/supabase-js": "^2.105.1",
    "argon2": "^0.44.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.6.1",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.1.0",
    "generate": "^0.14.0",
    "npx": "^10.2.2",
    "pluscodes": "^3.0.1",
    "prisma": "^6.15.0",
    "recharts": "^3.9.0",
    "resend": "^6.14.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
