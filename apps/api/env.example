# CoreMap API (apps/api) — copy to apps/api/.env or repo root .env
# apps/api/.env overrides repo root .env for duplicate keys (see server.ts).

PORT=3001

# CORS (comma-separated origins, optional)
# CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ── Public road routing (Valhalla adapter) ───────────────────────────────────
# When false, POST /api/routing/route will return 503 once implemented.
ROUTING_ENABLED=false

ROUTING_DEFAULT_ENGINE=valhalla
VALHALLA_BASE_URL=http://localhost:8002
# motorcycle | auto — force auto if tiles lack motorcycle costing
# VALHALLA_MOTORCYCLE_COSTING=motorcycle
ROUTING_REQUEST_TIMEOUT_MS=8000
ROUTING_PUBLIC_PROFILES=walk,car,motorcycle

# ── Admin routing graph build (Phase 9E — separate from public routing) ─────
# ENABLE_ROUTING_GRAPH_BUILD=true
# ENABLE_ROUTING_GRAPH_BULK_BUILD=true

# ── Import review (see apps/dashboard/env.example for dashboard vars) ───────
# ENABLE_IMPORT_REVIEW_ROAD_PROMOTION=true
