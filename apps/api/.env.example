# Example variable names for the Fastify API (no secrets). Copy real values into
# apps/api/.env for local dev, or set them in the platform env in production.
# Only the variables relevant to short-share-link domain wiring are documented
# here; see apps/api/.env for the full local set (DB, JWT, email, routing, etc.).

# --- Listen address (local phone-on-LAN) ---
# server.ts reads HOST and PORT directly. Default HOST is 0.0.0.0 (all interfaces).
# For a real Android phone on the same Wi-Fi, keep HOST=0.0.0.0 (do not use 127.0.0.1).
# Do not commit a LAN IP here. Production platforms usually inject PORT; HOST can stay 0.0.0.0.
HOST=0.0.0.0
PORT=3001

# --- Public app base URL (used to mint absolute /s/<code> share links) ---
# Local dev: the map app runs on the Vite port; keep localhost so generated
# links open YOUR local app for end-to-end testing.
PUBLIC_APP_URL=http://localhost:5173
# Production: the map app is served at map.coremapmm.com (NOT the landing page).
# /s/:code is handled by the map app, so links must be minted under map.*:
# PUBLIC_APP_URL=https://map.coremapmm.com
# Required in production (the API fails fast at startup if it is unset there).

# --- CORS allowlist (comma-separated; no trailing slashes) ---
# Browser origins allowed to call the API. In production, list every front-end
# origin that calls the API (map app, landing page, dashboard).
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
# Production example:
# CORS_ORIGIN=https://map.coremapmm.com,https://coremapmm.com,https://admin.coremapmm.com

# --- Cloudflare R2 media (backend only; never Android, never dashboard, never Git) ---
# Optional as a group. If any value is set, all required keys must be set.
# Buckets and media.coremapmm.com already exist; do not create them from this repo.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# R2_REGION=auto
# R2_MEDIA_PRIVATE_BUCKET=coremap-media-private
# R2_MEDIA_PUBLIC_BUCKET=coremap-media-public
# R2_MEDIA_PUBLIC_BASE_URL=https://media.coremapmm.com

# --- Prisma connection pool (per Node process) ---
# When DATABASE_URL has no connection_limit query param, the API appends one.
# Code default if unset: 1 (safe for tight Supabase poolers).
# Production transport target (Render): set PRISMA_CONNECTION_LIMIT=3
# PRISMA_CONNECTION_LIMIT=3
