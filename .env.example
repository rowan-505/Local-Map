# CoreMap root env template
# Copy to `.env` in this directory. Never commit real secrets.

# Direct PostgreSQL URL (local PostGIS and/or Supabase direct host, not the pooler)
DATABASE_URL=

# App-specific templates (copy those next to each app):
#   apps/api/env.example          → apps/api/.env
#   apps/web/.env.example         → apps/web/.env.local
#   apps/dashboard/.env.example   → apps/dashboard/.env.local
