#!/usr/bin/env bash
# =============================================================================
# Admin fast-core import — full env template (safe to commit; no secrets)
# =============================================================================
#
# Copy for each run:
#   cp imports/template.full.env imports/myanmar_admin_YYYY_MM_DD_v1.env
#
# Edit paths, password, and date tokens in SNAPSHOT_VERSION / BATCH_NAME, then:
#   ./run_admin_fast_core_pipeline.sh imports/myanmar_admin_YYYY_MM_DD_v1.env
#
# Does not run local-osm, road-fast-core, import_review, or Supabase upload.
# =============================================================================

export LOCAL_DATABASE_URL='postgresql://postgres:YOUR_PASSWORD@localhost:5433/geo_core'

export SOURCE_CODE='osm_myanmar'
export REGION_CODE='MM'

export PBF_PATH='/absolute/path/to/myanmar-latest.osm.pbf'
# Human PBF label; must be unique per source_registry unless SNAPSHOT_VERSION matches an existing row.
# Safe default: set SNAPSHOT_REF equal to SNAPSHOT_VERSION (see myanmar_admin example below).
export SNAPSHOT_REF='osm_myanmar_YYYY_MM_DD_admin_fast_v1'

export SNAPSHOT_VERSION='osm_myanmar_YYYY_MM_DD_admin_fast_v1'
export BATCH_NAME='myanmar_admin_fast_core_YYYY_MM_DD_v1'

export OSM2PGSQL_FLEX_FILE='lua/osm2pgsql_admin_only.lua'
export LOG_DIR='logs'

export TMP_ADMIN_SCHEMA='tmp_admin_import'
export RAW_SCHEMA='raw'
export STAGING_SCHEMA='staging'
export SYSTEM_SCHEMA='system'
export CORE_SCHEMA='core'

export FORCE_RECALCULATE_VERIFIED='false'

# --- Optional (runner may use defaults if unset) ---
# export OSM2PGSQL='osm2pgsql'
# export OSM2PGSQL_EXTRA_ARGS=''
# export PSQL_EXTRA_ARGS=''
