#!/usr/bin/env bash
# =============================================================================
# Local OSM import — full env template (safe to commit; no secrets)
# =============================================================================
#
# Copy for each import:
#   cp imports/template.full.env imports/kyauktan_2026_07_v4.env
#
# Edit the copy, then run:
#   ./run_local_osm_pipeline.sh imports/kyauktan_2026_07_v4.env
#
# Naming: see NAMINGENV.md in the parent folder.
# =============================================================================

# --- Local database (import lab only — not Supabase) ---
export LOCAL_DATABASE_URL='postgresql://postgres:YOUR_PASSWORD@localhost:5433/geo_core'

# --- Source registry (must exist in system.system_source_registry) ---
export SOURCE_CODE='osm_myanmar'
export REGION_CODE='MM-KYAUKTAN'

# --- Input extract ---
export PBF_PATH='/absolute/path/to/myanmar-latest.osm.pbf'
export SNAPSHOT_REF='myanmar-latest.osm.pbf'

# --- Import boundary (optional GeoJSON for clipped regional imports) ---
# Leave empty/unset for whole-country or whole-PBF imports (no spatial clip in Stage 04).
# Required for clipped sub-region runs (e.g. Kyauktan township extract).
export BOUNDARY_GEOJSON_PATH='/absolute/path/to/kyauktan-boundary.geojson'
export BOUNDARY_CODE='kyauktan_boundary'
export BOUNDARY_NAME='Kyauktan Township Boundary'
export BOUNDARY_VERSION='v4'
#
# Whole-country example (Myanmar admin-only import):
# export BOUNDARY_GEOJSON_PATH=''
# export BOUNDARY_CODE=''
# export BOUNDARY_NAME=''
# export BOUNDARY_VERSION=''
# export REGION_CODE='MM'

# --- Import identity (unique per run; see NAMINGENV.md) ---
export SNAPSHOT_VERSION='osm_myanmar_2026_07_kyauktan_v4'
export BATCH_NAME='kyauktan_osm_import_2026_07_v4'

# --- Integrity ---
# PBF and boundary checksums are calculated by the runner/scripts with shasum -a 256.

# --- osm2pgsql flex config for tmp_import stage ---
# Optional override. When unset, Stage 02 auto-selects Lua by ENTITY_FAMILIES:
#   admin_areas only → lua/osm2pgsql_admin_areas_only.lua  (tmp_import.osm_admin_polygons)
#   roads only       → lua/osm2pgsql_roads_only.lua        (tmp_import.osm_road_lines)
#   all / multiple   → lua/osm2pgsql_tmp_import.lua        (osm_points, osm_lines, osm_polygons)
# Entity-specific modes also require osmium-tool (brew install osmium-tool) to pre-filter the PBF.
# export OSM2PGSQL_FLEX_FILE='/absolute/path/to/Local-Map/tools/data-pipeline/local-osm/lua/osm2pgsql_tmp_import.lua'

# --- Pipeline logs (directory must exist or will be created by runner) ---
export LOG_DIR='/absolute/path/to/Local-Map/logs/data-pipeline'

# --- Pipeline entity scope (default: all families) ---
# Comma-separated slugs or 'all'. See README.md § Entity-specific pipeline runs.
# Examples:
#   export ENTITY_FAMILIES='all'
#   export ENTITY_FAMILIES='admin_areas'
#   export ENTITY_FAMILIES='roads'
#   export ENTITY_FAMILIES='places,addresses,address_components,place_address_links'
# export ENTITY_FAMILIES='all'

# --- Resume / performance (optional) ---
# Skip stages before N (e.g. 08 after 01-07 done, 12 after Stage J package ready):
# export PIPELINE_FROM_STAGE=''
# Helper scripts: ./run_resume_from_stage08.sh  ./run_resume_from_stage12.sh
# export PIPELINE_PSQL_WORK_MEM='512MB'
# export PIPELINE_PSQL_MAINTENANCE_WORK_MEM='1GB'

# --- Optional outbound review packages (Stages 11–15; never promotes to core) ---
# Exactly one runner mode applies:
#   - REMOTE_REVIEW_UPLOAD_ENABLED=true/1/yes → Stage J (.sql), K (.ts), L (.sql) in order (needs Supabase URL).
#   - REMOTE_REVIEW_PREPARE_VERIFY_ONLY=true/1/yes → Stage J + L only (local DB only — no Supabase upload).
#
# Required for either mode once enabled:
# export REMOTE_REVIEW_PACKAGE_NAME='remote_review_pkg_osm_myanmar_2026_07_kyauktan_v4'
#
# export REMOTE_REVIEW_UPLOAD_ENABLED='false'
# export REMOTE_REVIEW_PREPARE_VERIFY_ONLY='false'
# export SUPABASE_DATABASE_URL='postgresql://postgres:YOUR_PASSWORD@...:5432/postgres'
#
# Optional filters applied to Stage J, Stage K, and Stage L coverage when set.
# Classified place/address workflow families:
#   places | addresses | address_components | place_address_links
# Other supported families: buildings, roads, admin_areas, routing_barriers, bus_stops, landuse, water_*, etc.
# export REMOTE_REVIEW_ENTITY_FAMILY=''   # empty = all families in package (falls back to ENTITY_FAMILIES in Stage K)
#
# Smoke test / dry-run upload volume (limits rows per family in J and K — still writes to Supabase if upload enabled):
# export REMOTE_REVIEW_MAX_ROWS_PER_FAMILY=''  # e.g. 5 for smoke test; empty = unlimited
#
# Stage J replace: runner always uses replace_package=false. To overwrite same package name, rerun J manually with -v replace_package=true (see README_REMOTE_REVIEW.md).
#
# Optional strict TLS verification for Stage K vs Supabase (omit unless you need CA chain verify):
# export SUPABASE_DB_SSL_VERIFY_SERVER_CERT='true'
#
# Optional lineage QA (local-only 14_verify_lineage_alignment.sql, after Stage L):
# export REMOTE_LINEAGE_ALIGNMENT_VERIFY='true'
#
# Optional final read-only entity coverage + promotion-readiness report (Stage 15):
# export LOCAL_ENTITY_COVERAGE_REPORT_ENABLED='false'
# Optional if you want Stage 15 to add import_review batch-scoped counts:
# export REMOTE_REVIEW_BATCH_ID=''

# --- Optional schema overrides (defaults shown) ---
# export TMP_IMPORT_SCHEMA='tmp_import'
# export RAW_SCHEMA='raw'
# export STAGING_SCHEMA='staging'
# export SYSTEM_SCHEMA='system'
# export IMPORT_REVIEW_SCHEMA='import_review'
# export OSM2PGSQL='osm2pgsql'
# export PSQL_EXTRA_ARGS=''
# export ALLOW_BOUNDARY_UPDATE='false'
