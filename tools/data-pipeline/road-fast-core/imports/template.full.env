#!/usr/bin/env bash
# =============================================================================
# Road fast-core import — full env template (safe to commit; no secrets)
# =============================================================================
#
# Copy for each run:
#   cp imports/template.full.env imports/myanmar_roads_2026_06_03_v1.env
#
# Edit SNAPSHOT_VERSION / BATCH_NAME dates, paths, password, then:
#   ./run_road_fast_core_pipeline.sh imports/myanmar_roads_2026_06_03_v1.env
#
# Does not run local-osm, import_review, or Supabase upload.
# =============================================================================

export LOCAL_DATABASE_URL='postgresql://postgres:YOUR_PASSWORD@localhost:5433/geo_core'

export SOURCE_CODE='osm_myanmar'
export REGION_CODE='MM'

export PBF_PATH='/absolute/path/to/myanmar-latest.osm.pbf'
export SNAPSHOT_REF='myanmar-latest.osm.pbf'

# Use a new globally unique SNAPSHOT_VERSION per run (example date tokens):
export SNAPSHOT_VERSION='osm_myanmar_2026_06_03_roads_fast_v1'
export BATCH_NAME='myanmar_roads_fast_core_2026_06_03_v1'

# Relative to tools/data-pipeline/road-fast-core/ (runner resolves to absolute)
export OSM2PGSQL_FLEX_FILE='lua/osm2pgsql_roads_only.lua'
export LOG_DIR='logs'

export TMP_ROAD_SCHEMA='tmp_road_import'
export RAW_SCHEMA='raw'
export STAGING_SCHEMA='staging'
export SYSTEM_SCHEMA='system'
export CORE_SCHEMA='core'

# --- Optional (runner defaults shown) ---
# export APPLY_BOUNDARY_FILTER='false'
# export BOUNDARY_ID=''
# export CORE_PROMOTE_MODE='upsert'
# export OSM2PGSQL='osm2pgsql'
# export OSM2PGSQL_EXTRA_ARGS=''
# export PSQL_EXTRA_ARGS=''
# export ALLOW_BOUNDARY_UPDATE='false'
