# Copy to imports/<name>.env and run:
#   ./run_admin_hierarchy_repair.sh --hierarchy-only imports/<name>.env
#
# Supabase: set LOCAL_DATABASE_URL or DATABASE_URL to your pooler/direct URL.
# No tmp_import / raw / staging schemas required for --hierarchy-only.

LOCAL_DATABASE_URL='postgresql://USER:PASSWORD@127.0.0.1:5432/coremap'
# DATABASE_URL='postgresql://...'   # optional alias for LOCAL_DATABASE_URL

DRY_RUN=false
CONFIRM_WRITE=false
FORCE_RECALCULATE_VERIFIED=false
FORCE_MANUAL_OVERRIDE=false
LOG_DIR=logs
