#!/usr/bin/env bash
# =============================================================================
# transport-fast-publish — full env template (safe to commit; no secrets here)
# =============================================================================
#
# Copy for each run:
#   cp imports/template.full.env imports/myanmar_transport_2026_06_v1.env
#
# Edit SNAPSHOT_VERSION / PBF_PATH / password, then:
#   ./run_transport_fast_publish_pipeline.sh imports/myanmar_transport_2026_06_v1.env
#
# Two DB connections:
#   * LOCAL_DATABASE_URL          — osm2pgsql, tmp_transport_import,
#                                   local_transport_publish, local validation.
#   * SUPABASE_DIRECT_DATABASE_URL — ONLY final upsert into Supabase transport.*.
#                                    Required only when PUBLISH_TO_SUPABASE=true.
#
# Supabase never receives tmp/raw/staging schemas and never runs osm2pgsql.
# =============================================================================

# --- Connections -------------------------------------------------------------
export LOCAL_DATABASE_URL='postgresql://postgres:YOUR_PASSWORD@localhost:5433/geo_core'
# Required only when PUBLISH_TO_SUPABASE=true (use the Supabase DIRECT connection,
# not the pooler, for DDL/upserts):
export SUPABASE_DIRECT_DATABASE_URL=''

# --- Source PBF --------------------------------------------------------------
export PBF_PATH='/absolute/path/to/myanmar-latest.osm.pbf'

# --- Local-only schemas (must be exactly these values) -----------------------
export TMP_TRANSPORT_SCHEMA='tmp_transport_import'
export LOCAL_PUBLISH_SCHEMA='local_transport_publish'

# --- Source / batch identity -------------------------------------------------
export TRANSPORT_SOURCE_NAME='openstreetmap'
export TRANSPORT_SOURCE_KIND='osm_pbf'
export IMPORT_SCOPE='whole_country'
# Use a new globally unique SNAPSHOT_VERSION per run:
export SNAPSHOT_VERSION='osm_myanmar_transport_YYYY_MM'

# --- Binaries ----------------------------------------------------------------
export OSM2PGSQL_BIN='osm2pgsql'
export PSQL_BIN='psql'

# Keep tmp_transport_import after the run (true) or drop it at the end (false):
export KEEP_LOCAL_TMP_SCHEMA='true'

# --- Phase flags -------------------------------------------------------------
export IMPORT_POINTS='true'
export IMPORT_INFRASTRUCTURE_LINES='true'
export IMPORT_ROUTE_METADATA='false'
export IMPORT_ROUTE_PATHS='false'
export IMPORT_ROUTE_STOPS='false'
export PUBLISH_TO_SUPABASE='false'

# --- Optional (runner defaults shown) ----------------------------------------
# Relative paths resolve against the pipeline directory.
# export OSM2PGSQL_FLEX_FILE='lua/osm2pgsql_transport_only.lua'
# export LOG_DIR='logs'
# Stable upsert key; defaults to "<source_name>:<source_kind>:<snapshot_version>":
# export IMPORT_BATCH_KEY=''
# export OSM2PGSQL_EXTRA_ARGS=''
# export PSQL_EXTRA_ARGS=''
