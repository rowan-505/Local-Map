# Copy to infrastructure/tiles/martin/.env (gitignored), then fill in.
# Used by scripts/restart-local.sh for the local Docker Martin server.

# Supabase / Postgres URL for local Martin.
# Quote the value — unquoted & in query strings breaks bash `source`.
#
# Important:
# - Do NOT copy Prisma extras (pgbouncer, connection_limit, pool_timeout).
# - Do NOT use transaction pooler :6543 (Martin hangs; catalog never becomes ready).
# - Use session-mode pooler :5432 on the same host, or the direct db.*.supabase.co:5432 URL.
# Example (session pooler):
DATABASE_URL='postgresql://USER:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require'

# Optional overrides
# MARTIN_CONTAINER_NAME=coremap-martin-local
# MARTIN_HOST_PORT=3002
