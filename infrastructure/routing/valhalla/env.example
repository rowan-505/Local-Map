# Copy to infrastructure/routing/valhalla/.env (gitignored) or export in your shell.
# Used by docker compose and scripts/build-valhalla.sh.

VALHALLA_PORT=8002
VALHALLA_DATA_DIR=
VALHALLA_PBF_PATH=

# Optional clip bbox (defaults: Myanmar approximate bounds)
# VALHALLA_MIN_X=92.0
# VALHALLA_MIN_Y=9.5
# VALHALLA_MAX_X=101.5
# VALHALLA_MAX_Y=28.5

# Build performance (build-valhalla.sh defaults elevation off for faster local builds)
# build_elevation=False
# build_admins=True
# build_time_zones=True
