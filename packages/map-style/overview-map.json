{
  "version": 8,
  "name": "CoreMap Myanmar Overview",
  "metadata": {
    "local-map:purpose": "Natural Earth + MIMU admin1 overview basemap for z0–z8. Myanmar admin0 high-precision land-aligned tiers (z0–z6). Regional OSM admin from z7+. No OSM detail in overview tiles.",
    "local-map:zoom-range": "0-8",
    "local-map:visibility": "z0-4: ocean, land, boundaries, Myanmar outline | z4-6: neighbor country labels (no Myanmar) | z5.5-8: mmr_admin1 state labels | z7-8: major cities | z6-8: major lakes/rivers",
    "local-map:glyphs": "Self-hosted NotoSansMyanmar-Regular at /fonts/{fontstack}/{range}.pbf",
    "local-map:pmtiles-url": "Template only — pmtiles://__OVERVIEW_PMTILES_URL__. Web injects VITE_OVERVIEW_PMTILES_URL at runtime; use createOverviewStyle(httpUrl) elsewhere."
  },
  "glyphs": "/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "overview": {
      "type": "vector",
      "url": "pmtiles://__OVERVIEW_PMTILES_URL__",
      "minzoom": 0,
      "maxzoom": 8
    }
  },
  "layers": [
    {
      "id": "overview-ocean",
      "type": "fill",
      "source": "overview",
      "source-layer": "ocean",
      "maxzoom": 9,
      "paint": {
        "fill-color": "#b8ddea",
        "fill-opacity": 1
      }
    },
    {
      "id": "overview-land",
      "type": "fill",
      "source": "overview",
      "source-layer": "land",
      "maxzoom": 9,
      "paint": {
        "fill-color": "#e8ebe0",
        "fill-opacity": 1
      }
    },
    {
      "id": "overview-lakes",
      "type": "fill",
      "source": "overview",
      "source-layer": "lakes",
      "minzoom": 6,
      "maxzoom": 9,
      "filter": [
        "all",
        ["<=", ["coalesce", ["get", "min_zoom"], 0], ["zoom"]],
        ["<=", ["coalesce", ["get", "scalerank"], 99], 6]
      ],
      "paint": {
        "fill-color": "#c5dde8",
        "fill-opacity": [
          "interpolate",
          ["linear"],
          ["zoom"],
          6, 0.45,
          7, 0.62,
          8, 0.72
        ]
      }
    },
    {
      "id": "overview-rivers",
      "type": "line",
      "source": "overview",
      "source-layer": "rivers",
      "minzoom": 6,
      "maxzoom": 9,
      "filter": [
        "all",
        ["<=", ["coalesce", ["get", "min_zoom"], 0], ["zoom"]],
        ["<=", ["coalesce", ["get", "scalerank"], 99], 6]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#9cc6d8",
        "line-opacity": [
          "interpolate",
          ["linear"],
          ["zoom"],
          6, 0.4,
          7, 0.58,
          8, 0.7
        ],
        "line-width": [
          "interpolate",
          ["exponential", 1.2],
          ["zoom"],
          6, 0.4,
          7, 0.65,
          8, 0.95
        ]
      }
    },
    {
      "id": "overview-countries-fill",
      "type": "fill",
      "source": "overview",
      "source-layer": "countries",
      "maxzoom": 9,
      "paint": {
        "fill-color": "#e4e2dc",
        "fill-opacity": [
          "interpolate",
          ["linear"],
          ["zoom"],
          0, 0.16,
          4, 0.2,
          8, 0.26
        ]
      }
    },
    {
      "id": "overview-mmr-admin1-fill",
      "type": "fill",
      "source": "overview",
      "source-layer": "mmr_admin1",
      "minzoom": 4,
      "maxzoom": 9,
      "paint": {
        "fill-color": [
          "interpolate",
          ["linear"],
          ["%", ["to-number", ["coalesce", ["get", "PCode_V"], 0]], 16],
          0, "#e8e8f0",
          8, "#dfe8e4",
          15, "#ece6ea"
        ],
        "fill-opacity": [
          "interpolate",
          ["linear"],
          ["zoom"],
          4, 0.26,
          5, 0.34,
          7, 0.4,
          8, 0.42
        ]
      }
    },
    {
      "id": "overview-coastline",
      "type": "line",
      "source": "overview",
      "source-layer": "coastline",
      "minzoom": 5,
      "maxzoom": 9,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#8fb8c8",
        "line-opacity": [
          "interpolate",
          ["linear"],
          ["zoom"],
          5, 0.5,
          7, 0.75,
          8, 0.85
        ],
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          5, 0.35,
          7, 0.6,
          8, 0.85
        ]
      }
    },
    {
      "id": "neighbor-country-boundary-line",
      "type": "line",
      "source": "overview",
      "source-layer": "country_boundaries",
      "metadata": {
        "local-map:role": "neighbor-country-boundaries",
        "local-map:note": "Natural Earth neighbor land boundaries only. Myanmar segments excluded; mmr_admin0_z* tiers draw Myanmar admin0 through z6."
      },
      "maxzoom": 9,
      "filter": [
        "!",
        [
          "any",
          ["==", ["upcase", ["coalesce", ["get", "ADM0_A3_L"], ""]], "MMR"],
          ["==", ["upcase", ["coalesce", ["get", "ADM0_A3_R"], ""]], "MMR"],
          ["==", ["upcase", ["coalesce", ["get", "SOV_A3_L"], ""]], "MMR"],
          ["==", ["upcase", ["coalesce", ["get", "SOV_A3_R"], ""]], "MMR"],
          ["==", ["upcase", ["coalesce", ["get", "BRK_A3_L"], ""]], "MMR"],
          ["==", ["upcase", ["coalesce", ["get", "BRK_A3_R"], ""]], "MMR"],
          ["==", ["upcase", ["coalesce", ["get", "ADM0_LEFT"], ""]], "MYANMAR"],
          ["==", ["upcase", ["coalesce", ["get", "ADM0_RIGHT"], ""]], "MYANMAR"]
        ]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#b8b4c7",
        "line-opacity": ["interpolate", ["linear"], ["zoom"], 0, 0.28, 3, 0.4, 6, 0.52],
        "line-width": ["interpolate", ["linear"], ["zoom"], 0, 0.45, 3, 0.65, 6, 0.85]
      }
    },
    {
      "id": "myanmar-internal-admin-boundary-line",
      "type": "line",
      "source": "overview",
      "source-layer": "mmr_admin1",
      "metadata": {
        "local-map:role": "myanmar-internal-admin-boundaries",
        "local-map:note": "MIMU state/region internal boundaries. minzoom 3; subtler than myanmar-admin0-boundary-line."
      },
      "minzoom": 3,
      "maxzoom": 10,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#aaa4bd",
        "line-opacity": ["interpolate", ["linear"], ["zoom"], 3, 0.35, 5, 0.48, 6, 0.55],
        "line-width": ["interpolate", ["linear"], ["zoom"], 3, 0.45, 5, 0.65, 6, 0.8]
      }
    },
    {
      "id": "myanmar-admin0-boundary-casing-z02",
      "type": "line",
      "source": "overview",
      "source-layer": "mmr_admin0_z0_2",
      "metadata": {
        "local-map:role": "myanmar-admin0-boundary-casing",
        "local-map:note": "Subtle land-tone halo z0–z2 tier."
      },
      "minzoom": 0,
      "maxzoom": 3,
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#f6f5ee",
        "line-opacity": ["interpolate", ["linear"], ["zoom"], 0, 0.35, 3, 0.45, 6, 0.55],
        "line-width": ["interpolate", ["linear"], ["zoom"], 0, 1.4, 3, 1.8, 6, 2.2]
      }
    },
    {
      "id": "myanmar-admin0-boundary-line-z02",
      "type": "line",
      "source": "overview",
      "source-layer": "mmr_admin0_z0_2",
      "metadata": {
        "local-map:role": "myanmar-admin0-boundary-line",
        "local-map:note": "Myanmar admin0 z0–z2. source-layer mmr_admin0_z0_2."
      },
      "minzoom": 0,
      "maxzoom": 3,
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#5f5478",
        "line-opacity": ["interpolate", ["linear"], ["zoom"], 0, 0.72, 3, 0.82, 6, 0.88],
        "line-width": ["interpolate", ["linear"], ["zoom"], 0, 0.9, 3, 1.25, 6, 1.65]
      }
    },
    {
      "id": "myanmar-admin0-boundary-casing-z34",
      "type": "line",
      "source": "overview",
      "source-layer": "mmr_admin0_z3_4",
      "metadata": {
        "local-map:role": "myanmar-admin0-boundary-casing",
        "local-map:note": "Subtle land-tone halo z3–z4 tier."
      },
      "minzoom": 3,
      "maxzoom": 5,
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#f6f5ee",
        "line-opacity": ["interpolate", ["linear"], ["zoom"], 0, 0.35, 3, 0.45, 6, 0.55],
        "line-width": ["interpolate", ["linear"], ["zoom"], 0, 1.4, 3, 1.8, 6, 2.2]
      }
    },
    {
      "id": "myanmar-admin0-boundary-line-z34",
      "type": "line",
      "source": "overview",
      "source-layer": "mmr_admin0_z3_4",
      "metadata": {
        "local-map:role": "myanmar-admin0-boundary-line",
        "local-map:note": "Myanmar admin0 z3–z4. source-layer mmr_admin0_z3_4."
      },
      "minzoom": 3,
      "maxzoom": 5,
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#5f5478",
        "line-opacity": ["interpolate", ["linear"], ["zoom"], 0, 0.72, 3, 0.82, 6, 0.88],
        "line-width": ["interpolate", ["linear"], ["zoom"], 0, 0.9, 3, 1.25, 6, 1.65]
      }
    },
    {
      "id": "myanmar-admin0-boundary-casing-z56",
      "type": "line",
      "source": "overview",
      "source-layer": "mmr_admin0_z5_6",
      "metadata": {
        "local-map:role": "myanmar-admin0-boundary-casing",
        "local-map:note": "Subtle land-tone halo z5–z6 tier. Hidden z7+."
      },
      "minzoom": 5,
      "maxzoom": 7,
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#f6f5ee",
        "line-opacity": ["interpolate", ["linear"], ["zoom"], 0, 0.35, 3, 0.45, 6, 0.55],
        "line-width": ["interpolate", ["linear"], ["zoom"], 0, 1.4, 3, 1.8, 6, 2.2]
      }
    },
    {
      "id": "myanmar-admin0-boundary-line-z56",
      "type": "line",
      "source": "overview",
      "source-layer": "mmr_admin0_z5_6",
      "metadata": {
        "local-map:role": "myanmar-admin0-boundary-line",
        "local-map:note": "Myanmar admin0 z5–z6. source-layer mmr_admin0_z5_6. Hidden z7+."
      },
      "minzoom": 5,
      "maxzoom": 7,
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#5f5478",
        "line-opacity": ["interpolate", ["linear"], ["zoom"], 0, 0.72, 3, 0.82, 6, 0.88],
        "line-width": ["interpolate", ["linear"], ["zoom"], 0, 0.9, 3, 1.25, 6, 1.65]
      }
    },
    {
      "id": "overview-country-labels",
      "type": "symbol",
      "source": "overview",
      "source-layer": "countries",
      "minzoom": 3,
      "maxzoom": 6.5,
      "filter": [
        "all",
        ["!=", ["coalesce", ["get", "TINY"], 0], 1],
        [
          "<=",
          ["coalesce", ["get", "LABELRANK"], 10],
          ["step", ["zoom"], 4, 5.5, 5, 6, 6]
        ],
        [
          "!",
          [
            "any",
            ["==", ["upcase", ["coalesce", ["get", "ISO_A3"], ["get", "iso_a3"], ""]], "MMR"],
            ["==", ["upcase", ["coalesce", ["get", "ADMIN"], ""]], "MYANMAR"],
            ["==", ["upcase", ["coalesce", ["get", "BRK_A3"], ""]], "MMR"]
          ]
        ]
      ],
      "layout": {
        "symbol-placement": "point",
        "text-field": [
          "coalesce",
          ["get", "NAME"],
          ["get", "ADMIN"],
          ["get", "NAME_EN"],
          ["get", "NAME_LONG"]
        ],
        "text-font": ["NotoSansMyanmar-Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 3, 10.5, 5, 12],
        "text-max-width": 7,
        "text-padding": 52,
        "text-allow-overlap": false,
        "text-ignore-placement": false,
        "text-optional": true,
        "symbol-sort-key": ["-", ["coalesce", ["get", "LABELRANK"], 10]]
      },
      "paint": {
        "text-color": "#6f7488",
        "text-halo-color": "#f4f3ec",
        "text-halo-width": 0.9,
        "text-halo-blur": 0.25,
        "text-opacity": [
          "interpolate",
          ["linear"],
          ["zoom"],
          4, 0.72,
          5, 0.88,
          6, 0.8,
          6.5, 0.2
        ]
      }
    },
    {
      "id": "overview-mmr-admin1-labels",
      "type": "symbol",
      "source": "overview",
      "source-layer": "mmr_admin1",
      "minzoom": 4,
      "maxzoom": 9,
      "filter": [
        "all",
        [
          "!=",
          [
            "coalesce",
            ["get", "ST_MMR"],
            ["get", "ST"],
            ["get", "SR_MMR"],
            ["get", "SR"],
            ""
          ],
          ""
        ]
      ],
      "layout": {
        "symbol-placement": "point",
        "text-field": [
          "coalesce",
          ["get", "ST"],
          ["get", "ST_MMR"],
          ["get", "SR"],
          ["get", "SR_MMR"],
          ["get", "NAME"],
          ["get", "name"]
        ],
        "text-font": ["NotoSansMyanmar-Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 4, 10.5, 5, 11.5, 6, 12.5],
        "text-max-width": 9,
        "text-padding": 56,
        "text-allow-overlap": false,
        "text-ignore-placement": false,
        "text-optional": true,
        "symbol-sort-key": ["coalesce", ["to-number", ["get", "PCode_V"]], 99]
      },
      "paint": {
        "text-color": "#74708b",
        "text-halo-color": "#f4f3ec",
        "text-halo-width": 0.8,
        "text-halo-blur": 0.2,
        "text-opacity": ["interpolate", ["linear"], ["zoom"], 4, 0.55, 5, 0.75, 6, 0.85]
      }
    },
    {
      "id": "overview-populated-places",
      "type": "symbol",
      "source": "overview",
      "source-layer": "populated_places",
      "minzoom": 7,
      "maxzoom": 9,
      "filter": [
        "any",
        ["<=", ["to-number", ["coalesce", ["get", "SCALERANK"], ["get", "scalerank"], 99]], 4],
        ["==", ["to-number", ["coalesce", ["get", "ADM0CAP"], ["get", "adm0cap"], 0]], 1]
      ],
      "layout": {
        "symbol-placement": "point",
        "text-field": [
          "coalesce",
          ["get", "NAME"],
          ["get", "NAMEASCII"],
          ["get", "name"],
          ["get", "nameascii"]
        ],
        "text-font": ["NotoSansMyanmar-Regular"],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          7,
          [
            "case",
            ["==", ["coalesce", ["get", "ADM0CAP"], 0], 1],
            10.5,
            9.5
          ],
          8,
          [
            "case",
            ["==", ["coalesce", ["get", "ADM0CAP"], 0], 1],
            12,
            10.5
          ]
        ],
        "text-max-width": 7,
        "text-padding": 48,
        "text-allow-overlap": false,
        "text-ignore-placement": false,
        "text-optional": true,
        "symbol-sort-key": ["coalesce", ["to-number", ["get", "SCALERANK"], ["get", "scalerank"]], 99]
      },
      "paint": {
        "text-color": "#3d4a5c",
        "text-halo-color": "#f7f8f6",
        "text-halo-width": 1.6,
        "text-halo-blur": 0.35,
        "text-opacity": [
          "interpolate",
          ["linear"],
          ["zoom"],
          7, 0.62,
          8, 0.88
        ]
      }
    }
  ]
}
